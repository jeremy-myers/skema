    "version": "0.2.0",
    "configurations": [
        {
            "name": "SketchySVD rectangular sparse, Gauss DR",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/skema",
            "args": [
                "--input",
                "${workspaceFolder}/test/data-prev/rectangular_sparse.mtx",
                "--window",
                "8",
                "--solver",
                "sketchy_svd",
                "--sparse",
                "--history-file",
                "sketchysvd-sparse-gaussdr.json",
                "--rank",
                "5"
            ],
            "environment": [
                {
                    "name": "config",
                    "value": "Debug"
                }
            ],
            "cwd": "${workspaceFolder}",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": true
        },
